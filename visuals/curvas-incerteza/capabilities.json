{
    "dataRoles": [
        {
            "displayName": "Eixo X",
            "displayNameKey": "Role_X",
            "description": "Agrupamento ordenado: número e data viram eixo contínuo; texto fica na ordem do modelo.",
            "descriptionKey": "Role_X_Desc",
            "name": "x",
            "kind": "Grouping"
        },
        {
            "displayName": "Série",
            "displayNameKey": "Role_Series",
            "description": "Opcional: uma curva por valor (aceita parâmetro de campo).",
            "descriptionKey": "Role_Series_Desc",
            "name": "series",
            "kind": "Grouping"
        },
        {
            "displayName": "Valor",
            "displayNameKey": "Role_Value",
            "description": "Altura da curva; vazio interrompe a linha (nunca vira zero).",
            "descriptionKey": "Role_Value_Desc",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "Limite inferior",
            "displayNameKey": "Role_Lower",
            "description": "Opcional: faixa sombreada (só aparece com os dois limites).",
            "descriptionKey": "Role_Limits_Desc",
            "name": "lower",
            "kind": "Measure"
        },
        {
            "displayName": "Limite superior",
            "displayNameKey": "Role_Upper",
            "description": "Opcional: faixa sombreada (só aparece com os dois limites).",
            "descriptionKey": "Role_Limits_Desc",
            "name": "upper",
            "kind": "Measure"
        },
        {
            "displayName": "Confiança",
            "displayNameKey": "Role_Confidence",
            "description": "Opcional: ponto de baixa confiança quando Confiança < Limiar. Vazio = ponto normal.",
            "descriptionKey": "Role_Confidence_Desc",
            "name": "confidence",
            "kind": "Measure"
        },
        {
            "displayName": "Limiar de confiança",
            "displayNameKey": "Role_Threshold",
            "description": "Opcional: se vazio, usa a constante do painel (padrão 1).",
            "descriptionKey": "Role_Threshold_Desc",
            "name": "threshold",
            "kind": "Measure"
        },
        {
            "displayName": "Destaque",
            "displayNameKey": "Role_Highlight",
            "description": "Opcional: pontos com valor diferente de 0 formam janelas sombreadas no fundo.",
            "descriptionKey": "Role_Highlight_Desc",
            "name": "highlight",
            "kind": "Measure"
        },
        {
            "displayName": "Marcas",
            "displayNameKey": "Role_Marks",
            "description": "Opcional: valor > 0 desenha um tique na curva (ex.: censuras).",
            "descriptionKey": "Role_Marks_Desc",
            "name": "marks",
            "kind": "Measure"
        },
        {
            "displayName": "Referência",
            "displayNameKey": "Role_Reference",
            "description": "Opcional: linha horizontal (alternativa à constante do painel).",
            "descriptionKey": "Role_Reference_Desc",
            "name": "reference",
            "kind": "Measure"
        },
        {
            "displayName": "Dicas de ferramenta",
            "displayNameKey": "Role_Tooltips",
            "description": "Medidas extras mostradas ao passar o mouse.",
            "descriptionKey": "Role_Tooltips_Desc",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
