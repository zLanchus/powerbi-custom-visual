{
    "dataRoles": [
        {
            "displayName": "Texto do botão",
            "name": "label",
            "kind": "Measure",
            "description": "Opcional: medida de texto que substitui o texto do botão."
        },
        {
            "displayName": "Subtítulo do botão",
            "name": "subtitle",
            "kind": "Measure",
            "description": "Opcional: medida de texto mostrada embaixo do texto do botão."
        },
        {
            "displayName": "Título do pop-up",
            "name": "popupTitle",
            "kind": "Measure",
            "description": "Opcional: medida com o título do pop-up."
        },
        {
            "displayName": "Texto do pop-up",
            "name": "popupText",
            "kind": "Measure",
            "description": "Opcional: medida com o texto explicativo (use UNICHAR(10) para quebrar linha). Tem prioridade sobre o texto do painel."
        }
