    "dataViewMappings": [
        {
            "conditions": [
                {
                    "reason": {
                        "max": 1
                    },
                    "detail": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    }
                }
            ],
            "matrix": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "reason"
                            }
                        },
                        {
                            "for": {
                                "in": "detail"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "for": {
                                "in": "value"
                            }
                        },
                        {
                            "for": {
                                "in": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "subtotals": {
        "matrix": {
            "rowSubtotals": {
                "propertyIdentifier": {
                    "objectName": "totals",
                    "propertyName": "rowSubtotals"
                },
                "defaultValue": true
            },
            "rowSubtotalsPerLevel": {
                "propertyIdentifier": {
                    "objectName": "totals",
                    "propertyName": "rowSubtotalsPerLevel"
                },
                "defaultValue": false
            },
            "columnSubtotals": {
