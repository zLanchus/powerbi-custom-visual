            "name": "detail",
            "kind": "Grouping"
        },
        {
            "displayName": "Valor",
            "description": "Medida que dá o tamanho de cada motivo (ex.: Contagem de respostas).",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "Dicas de ferramenta",
            "description": "Medidas extras mostradas ao passar o mouse.",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
