    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "legend": {
                        "max": 0
                    }
                },
                {
                    "category": {
                        "max": 1
                    },
                    "legend": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 60
                        }
                    }
                },
                "values": {
                    "group": {
                        "by": "legend",
                        "select": [
                            {
                                "for": {
                                    "in": "value"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 30
                            }
                        }
                    }
                }
            }
        }
    ],
    "sorting": {
        "default": {}
    },
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "roles": [
            "tooltips"
        ]
    },
    "supportsMultiVisualSelection": true,
    "supportsKeyboardFocus": true,
    "supportsLandingPage": false,
    "suppressDefaultTitle": false,
    "privileges": []
}