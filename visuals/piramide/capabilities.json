{
    "dataRoles": [
        {
            "displayName": "Categoria",
            "description": "Cada valor vira uma barra (um degrau da pirâmide).",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Legenda",
            "description": "Divide cada barra em segmentos coloridos (com Legenda, use uma medida em Valores).",
            "name": "legend",
            "kind": "Grouping"
        },
        {
            "displayName": "Valores",
            "description": "Medida que define o tamanho das barras. Sem Legenda, dá para colocar várias medidas: cada uma vira um segmento.",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "Dicas de ferramenta",
            "description": "Medidas extras mostradas ao passar o mouse.",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
