    "dataViewMappings": [
        {
            "conditions": [
                {
                    "rows": {
                        "min": 0
                    },
                    "columns": {
                        "min": 0,
                        "max": 4
                    },
                    "base": {
                        "max": 1
                    }
                }
            ],
            "matrix": {
                "rows": {
                    "for": {
                        "in": "rows"
                    },
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 30000
                        }
                    }
                },
                "columns": {
                    "for": {
                        "in": "columns"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 100
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "for": {
                                "in": "values"
                            }
                        },
                        {
                            "for": {
                                "in": "base"
                            }
                        },
                        {
                            "for": {
                                "in": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "subtotals": {
        "matrix": {
            "rowSubtotals": {
                "propertyIdentifier": {
                    "objectName": "totals",
                    "propertyName": "rowSubtotals"
                },
                "defaultValue": true
            },
            "rowSubtotalsPerLevel": {
                "propertyIdentifier": {
                    "objectName": "totals",
                    "propertyName": "rowSubtotalsPerLevel"
                },
                "defaultValue": false
            },
            "columnSubtotals": {
                "propertyIdentifier": {
                    "objectName": "totals",
                    "propertyName": "columnSubtotals"
                },
                "defaultValue": true
            },
            "columnSubtotalsPerLevel": {
