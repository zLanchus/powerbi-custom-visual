                },
                "defaultValue": false
            },
            "levelSubtotalEnabled": {
                "propertyIdentifier": {
                    "objectName": "totals",
                    "propertyName": "levelSubtotalEnabled"
                },
                "defaultValue": true
            },
            "rowSubtotalsType": {
                "propertyIdentifier": {
                    "objectName": "totals",
                    "propertyName": "rowSubtotalsType"
                },
                "defaultValue": "Bottom"
            }
        }
