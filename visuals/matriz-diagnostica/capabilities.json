{
    "dataRoles": [
        {
            "displayName": "Linhas",
            "name": "rows",
            "kind": "Grouping",
            "description": "Campos das linhas (ou um parâmetro de campo). Com mais de um campo, as linhas viram uma hierarquia que abre ao clicar."
        },
        {
            "displayName": "Colunas",
            "name": "columns",
            "kind": "Grouping",
            "description": "Campos das colunas (opcional), como na matriz nativa. Com um campo de tempo (ex.: Mês), aparece a coluna de tendência."
        },
        {
            "displayName": "Valores",
            "name": "values",
            "kind": "Measure",
            "description": "Medidas exibidas (ex.: Turnover %, Desligamentos, Headcount)."
        },
        {
            "displayName": "Base (volume)",
            "name": "base",
            "kind": "Measure",
            "description": "Opcional: medida de volume (ex.: Headcount médio). Células com base abaixo da base mínima são marcadas como amostra pequena e ficam fora do mapa de calor e dos pontos de atenção."
        },
        {
            "displayName": "Dicas de ferramenta",
            "name": "tooltips",
            "kind": "Measure",
            "description": "Medidas extras mostradas só ao passar o mouse."
        }
    ],
