{
    "dataRoles": [
        {
            "displayName": "Categoria",
            "displayNameKey": "Role_Category",
            "description": "Uma barra (ou um grupo de barras) por valor.",
            "descriptionKey": "Role_Category_Desc",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Série",
            "displayNameKey": "Role_Series",
            "description": "Opcional: barras agrupadas lado a lado dentro da categoria.",
            "descriptionKey": "Role_Series_Desc",
            "name": "series",
            "kind": "Grouping"
        },
        {
            "displayName": "Valor",
            "displayNameKey": "Role_Value",
            "description": "Comprimento da barra.",
            "descriptionKey": "Role_Value_Desc",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "Comparação 1",
            "displayNameKey": "Role_Comparison1",
            "description": "Opcional: marcador sobre a barra (ex.: ano anterior).",
            "descriptionKey": "Role_Comparison_Desc",
            "name": "comparison1",
            "kind": "Measure"
        },
        {
            "displayName": "Comparação 2",
            "displayNameKey": "Role_Comparison2",
            "description": "Opcional: segundo marcador sobre a barra (ex.: meta).",
            "descriptionKey": "Role_Comparison_Desc",
            "name": "comparison2",
            "kind": "Measure"
        },
        {
            "displayName": "Referência",
            "displayNameKey": "Role_Reference",
            "description": "Opcional: igual em todas as categorias vira uma linha única; diferente, um traço por barra.",
            "descriptionKey": "Role_Reference_Desc",
            "name": "reference",
            "kind": "Measure"
        },
        {
            "displayName": "Sinalizador",
            "displayNameKey": "Role_Flag",
            "description": "Opcional: valor diferente de 0 pinta a barra com a cor de destaque.",
            "descriptionKey": "Role_Flag_Desc",
            "name": "flag",
            "kind": "Measure"
        },
        {
            "displayName": "Confiança",
            "displayNameKey": "Role_Confidence",
            "description": "Opcional: a barra é de baixa confiança quando Confiança < Limiar. Vazio = barra normal.",
            "descriptionKey": "Role_Confidence_Desc",
            "name": "confidence",
            "kind": "Measure"
        },
        {
            "displayName": "Limiar de confiança",
            "displayNameKey": "Role_Threshold",
            "description": "Opcional: se vazio, usa a constante do painel (padrão 1).",
            "descriptionKey": "Role_Threshold_Desc",
            "name": "threshold",
            "kind": "Measure"
        },
        {
            "displayName": "Rótulo extra",
            "displayNameKey": "Role_ExtraLabel",
            "description": "Opcional: texto curto sob o rótulo da categoria (ex.: \"56 saídas\").",
            "descriptionKey": "Role_ExtraLabel_Desc",
            "name": "extraLabel",
            "kind": "Measure"
        },
        {
            "displayName": "Dicas de ferramenta",
            "displayNameKey": "Role_Tooltips",
            "description": "Medidas extras mostradas ao passar o mouse.",
            "descriptionKey": "Role_Tooltips_Desc",
            "name": "tooltips",
            "kind": "Measure"
        }
    ],
