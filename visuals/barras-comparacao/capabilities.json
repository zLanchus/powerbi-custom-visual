    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "series": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    },
                    "comparison1": {
                        "max": 1
                    },
                    "comparison2": {
                        "max": 1
                    },
                    "reference": {
                        "max": 1
                    },
                    "flag": {
                        "max": 1
                    },
                    "confidence": {
                        "max": 1
                    },
                    "threshold": {
                        "max": 1
                    },
                    "extraLabel": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1001
                        }
                    }
                },
                "values": {
                    "group": {
                        "by": "series",
                        "select": [
                            {
                                "bind": {
                                    "to": "value"
                                }
                            },
                            {
                                "bind": {
                                    "to": "comparison1"
                                }
                            },
                            {
                                "bind": {
                                    "to": "comparison2"
                                }
                            },
                            {
                                "bind": {
                                    "to": "reference"
                                }
                            },
                            {
                                "bind": {
                                    "to": "flag"
                                }
                            },
                            {
                                "bind": {
                                    "to": "confidence"
                                }
                            },
                            {
                                "bind": {
                                    "to": "threshold"
                                }
                            },
                            {
                                "bind": {
                                    "to": "extraLabel"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 31
                            }
                        }
                    }
                }
            }
        }
