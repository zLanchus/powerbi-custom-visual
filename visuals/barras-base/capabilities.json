    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "legend": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    },
                    "detail": {
                        "max": 1
                    }
                }
            ],
            "matrix": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "category"
                            }
                        },
                        {
                            "for": {
                                "in": "columns"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 10000
                        }
                    }
                },
                "columns": {
                    "for": {
                        "in": "legend"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "for": {
                                "in": "value"
                            }
                        },
                        {
                            "for": {
                                "in": "detail"
                            }
                        },
                        {
                            "for": {
                                "in": "columnMeasures"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "subtotals": {
        "matrix": {
            "rowSubtotals": {
                "propertyIdentifier": {
                    "objectName": "totals",
