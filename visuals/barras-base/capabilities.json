{
    "dataRoles": [
        {
            "displayName": "Eixo",
            "description": "Cada valor vira uma barra (ex.: Região, Cargo).",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Legenda",
            "description": "Divide cada barra em segmentos coloridos (ex.: Status).",
            "name": "legend",
            "kind": "Grouping"
        },
        {
            "displayName": "Valores",
            "description": "Medida que define o tamanho das barras. Para contar pessoas, arraste o ID ou o nome e escolha Contagem.",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "Detalhe",
            "description": "Medida mostrada ao lado do valor, ex.: 61 (R$ 420 mil). A barra junta os registros por soma, média, mínimo ou máximo (Formatar → Detalhe).",
            "name": "detail",
            "kind": "Measure"
        },
        {
            "displayName": "Colunas da base",
            "description": "Colunas da base nominal, na ordem em que forem adicionadas (ex.: Nome, Matrícula, Cidade).",
            "name": "columns",
            "kind": "Grouping"
        },
        {
            "displayName": "Medidas da base",
            "description": "Medidas mostradas como colunas da base nominal, calculadas para cada registro.",
            "name": "columnMeasures",
            "kind": "Measure"
        }
    ],
