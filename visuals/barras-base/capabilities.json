{
    "dataRoles": [
        {
            "displayName": "Eixo",
            "description": "Cada valor vira uma barra (ex.: Região, Cargo).",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Legenda",
            "description": "Divide cada barra em segmentos coloridos (ex.: Status).",
            "name": "legend",
            "kind": "Grouping"
        },
        {
            "displayName": "Valores",
            "description": "Medida que define o tamanho das barras (contagem, soma, %…), calculada pelo Power BI para cada barra e segmento. Para contar pessoas, arraste a matrícula e escolha Contagem.",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "Detalhe",
            "description": "Outra medida mostrada ao lado do valor, ex.: 24,2% (18). Calculada pelo Power BI para cada barra e segmento.",
            "name": "detail",
            "kind": "Measure"
        },
        {
            "displayName": "Colunas da base",
            "description": "Colunas da base nominal, na ordem em que forem adicionadas (ex.: Nome, Matrícula, Cidade).",
            "name": "columns",
            "kind": "Grouping"
        },
        {
            "displayName": "Medidas da base",
            "description": "Medidas mostradas como colunas da base nominal, calculadas para cada registro.",
            "name": "columnMeasures",
            "kind": "Measure"
        }
    ],
