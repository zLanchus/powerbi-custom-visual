    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "legend": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    },
                    "detail": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "for": {
                                "in": "category"
                            }
                        },
                        {
                            "for": {
                                "in": "columns"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 10000
                        }
                    }
                },
                "values": {
                    "group": {
                        "by": "legend",
                        "select": [
                            {
                                "for": {
                                    "in": "value"
                                }
                            },
                            {
                                "for": {
                                    "in": "detail"
                                }
                            },
                            {
                                "for": {
                                    "in": "columnMeasures"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 30
                            }
                        }
                    }
                }
            }
        }
    ],
