{
    "dataRoles": [
        {
            "displayName": "Filtro aninhado 1",
            "description": "As colunas colocadas aqui viram um único filtro em árvore, na ordem em que foram adicionadas (a primeira é o nível de cima).",
            "name": "nest1",
            "kind": "Grouping"
        },
        {
            "displayName": "Filtro aninhado 2",
            "description": "As colunas colocadas aqui viram um único filtro em árvore, na ordem em que foram adicionadas (a primeira é o nível de cima).",
            "name": "nest2",
            "kind": "Grouping"
        },
        {
            "displayName": "Filtro aninhado 3",
            "description": "As colunas colocadas aqui viram um único filtro em árvore, na ordem em que foram adicionadas (a primeira é o nível de cima).",
            "name": "nest3",
            "kind": "Grouping"
        },
        {
            "displayName": "Filtro aninhado 4",
            "description": "As colunas colocadas aqui viram um único filtro em árvore, na ordem em que foram adicionadas (a primeira é o nível de cima).",
            "name": "nest4",
            "kind": "Grouping"
        },
        {
            "displayName": "Filtros sem aninhamento",
            "description": "Cada coluna colocada aqui vira um filtro separado no pop-up.",
            "name": "fields",
            "kind": "Grouping"
        },
        {
            "displayName": "Ligação entre tabelas (opcional)",
            "description": "Necessário quando há colunas de tabelas sem relacionamento entre si (ex.: tabela criada no próprio Power BI). Coloque aqui uma medida que use todas as tabelas envolvidas — veja o README do visual.",
            "name": "link",
            "kind": "Measure"
        },
        {
            "displayName": "Catálogo: Filtro",
            "name": "catName",
            "kind": "Grouping",
            "description": "Modo catálogo: coluna com o nome de cada filtro (ex.: \"Área\"). Veja o README."
        },
        {
            "displayName": "Catálogo: Coluna",
            "name": "catColumn",
            "kind": "Grouping",
            "description": "Modo catálogo: coluna com a coluna real a filtrar, no formato Tabela[Coluna] (filtro aninhado: Tabela[Ano] | Tabela[Mês])."
        },
        {
            "displayName": "Catálogo: Valor",
            "name": "catValue",
            "kind": "Grouping",
            "description": "Modo catálogo: coluna com o valor (texto). Filtro aninhado: valores separados por | ."
        },
        {
            "displayName": "Catálogo: Tipo (opcional)",
            "name": "catType",
            "kind": "Grouping",
            "description": "Modo catálogo: texto, número ou data (padrão: texto). Filtro aninhado: tipos separados por | ."
        },
        {
            "displayName": "Catálogo: Ordem (opcional)",
            "name": "catOrder",
            "kind": "Grouping",
            "description": "Modo catálogo: número para ordenar os valores (ex.: AnoMês). Sem ordem, os valores ficam em ordem alfabética."
        }
    ],
