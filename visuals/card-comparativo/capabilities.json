                            }
                        }
                    }
                },
                "bold": {
                    "type": {
                        "bool": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "main": {
                        "max": 1
                    },
                    "period": {
                        "max": 1
                    },
                    "comparisons": {
                        "max": 5
                    },
                    "detailTop": {
                        "max": 1
                    },
                    "detailBottom": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "main"
                            }
                        },
                        {
                            "bind": {
                                "to": "period"
                            }
                        },
                        {
                            "for": {
                                "in": "comparisons"
                            }
                        },
                        {
                            "bind": {
                                "to": "detailTop"
                            }
                        },
                        {
                            "bind": {
                                "to": "detailBottom"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "supportsKeyboardFocus": true,
    "supportsLandingPage": false,
    "suppressDefaultTitle": false,
    "privileges": []
}