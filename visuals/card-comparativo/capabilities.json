                            }
                        }
                    }
                },
                "neutralColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "labelPosition": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "right",
                                "displayName": "À direita"
                            },
                            {
                                "value": "left",
                                "displayName": "À esquerda"
                            }
                        ]
                    }
                },
                "labelSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "labelColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "labelBold": {
                    "type": {
                        "bool": true
                    }
                },
                "valueSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "valueColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "emptyText": {
                    "type": {
                        "text": true
                    }
                },
                "emptyColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "dividers": {
